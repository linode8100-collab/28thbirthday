/* ==================================
   BALLOONS
================================== */

function startBalloons() {

    setInterval(
        createBalloon,
        1000
    );

}


function createBalloon() {

    const balloon =
        document.createElement("div");

    balloon.className =
        "balloon";


    const colors = [
        "#ff82ac",
        "#ffb1c9",
        "#e96c9a",
        "#ffc6da",
        "#f38caf",
        "#d95c8d"
    ];


    balloon.style.background =
        colors[
            Math.floor(
                Math.random()
                * colors.length
            )
        ];


    balloon.style.left =
        Math.random()
        * 90
        + "%";


    balloon.style.setProperty(
        "--drift",
        (
            Math.random() * 100 - 50
        ) + "px"
    );


    balloon.style.animationDuration =
        (
            5 +
            Math.random() * 4
        ) + "s";


    balloon.addEventListener(
        "click",
        () => {

            balloon.classList.add(
                "pop"
            );

            createSparkles(8);

            createHeartExplosion(4);

            setTimeout(
                () =>
                    balloon.remove(),
                300
            );

        }
    );


    balloonArea.appendChild(
        balloon
    );


    setTimeout(
        () =>
            balloon.remove(),
        10000
    );

}


/* ==================================
   FINAL SURPRISE
================================== */

surpriseBtn.addEventListener(
    "click",
    () => {

        createHeartExplosion(100);

        createSparkles(70);

        setTimeout(
            () => {

                finalSurprise.classList.add(
                    "show"
                );

            },
            700
        );

    }
);


closeFinal.addEventListener(
    "click",
    () => {

        finalSurprise.classList.remove(
            "show"
        );

        createHeartExplosion(40);

    }
);


/* ==================================
   FLOATING HEARTS
================================== */

function createHeartExplosion(
    amount
) {

    for (
        let i = 0;
        i < amount;
        i++
    ) {

        setTimeout(
            createFloatingHeart,
            i * 25
        );

    }

}


function createFloatingHeart() {

    const heart =
        document.createElement("div");

    heart.className =
        "floating";


    const symbols = [
        "❤️",
        "💕",
        "💗",
        "💖",
        "💘",
        "💞",
        "🌸",
        "✨"
    ];


    heart.textContent =
        symbols[
            Math.floor(
                Math.random()
                * symbols.length
            )
        ];


    heart.style.left =
        Math.random()
        * 100
        + "vw";


    heart.style.fontSize =
        (
            18 +
            Math.random() * 30
        ) + "px";


    heart.style.animationDuration =
        (
            4 +
            Math.random() * 5
        ) + "s";


    document.body.appendChild(
        heart
    );


    setTimeout(
        () =>
            heart.remove(),
        10000
    );

}


/* ==================================
   SPARKLES
================================== */

function createSparkles(
    amount
) {

    for (
        let i = 0;
        i < amount;
        i++
    ) {

        setTimeout(
            createSparkle,
            i * 25
        );

    }

}


function createSparkle() {

    const sparkle =
        document.createElement("div");

    sparkle.className =
        "sparkle";

    sparkle.textContent =
        "✨";


    sparkle.style.left =
        Math.random()
        * 100
        + "vw";


    sparkle.style.top =
        Math.random()
        * 100
        + "vh";


    sparkle.style.fontSize =
        (
            15 +
            Math.random() * 30
        ) + "px";


    document.body.appendChild(
        sparkle
    );


    setTimeout(
        () =>
            sparkle.remove(),
        1000
    );

}


/* ==================================
   AMBIENT EFFECTS
================================== */

setInterval(
    () => {

        if (
            !welcome.classList.contains(
                "hide"
            )
        ) return;

        createFloatingHeart();

    },
    1800
);


</script>

