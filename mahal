<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#ff8fb3">

<title>Happy 28th Birthday, Mahal 💕</title>

<style>

@import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@400;500;600;700&family=Dancing+Script:wght@500;600;700&display=swap');


/* ==============================
   BASIC
============================== */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    overflow-x: hidden;

    font-family: 'Baloo 2', cursive;

    color: #632b47;

    background:
        radial-gradient(circle at 20% 20%, #fff 0 2px, transparent 3px),
        linear-gradient(
            135deg,
            #ffdce9,
            #fff7fb,
            #ffd1e2
        );

    background-size:
        90px 90px,
        100% 100%;

    transition: background 1s ease;
}


/* ==============================
   WELCOME SCREEN
============================== */

#welcome {
    position: fixed;

    inset: 0;

    z-index: 1000;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 25px;

    background:
        radial-gradient(
            circle at center,
            #fff4f9,
            #ffbfd5,
            #f98caf
        );

    transition:
        opacity 1s ease,
        visibility 1s ease;
}

#welcome.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.welcome-box {
    width: min(92vw, 550px);

    padding: 45px 25px;

    border-radius: 40px;

    background:
        rgba(255,255,255,.8);

    backdrop-filter: blur(20px);

    box-shadow:
        0 30px 80px
        rgba(150,45,90,.25);

    animation:
        welcomeFloat
        3s
        ease-in-out
        infinite;
}

@keyframes welcomeFloat {

    0%,100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }
}

.welcome-emoji {
    font-size: 65px;

    animation:
        heartbeat
        1.5s
        infinite;
}

.welcome-box h2 {

    margin-top: 15px;

    color: #d34478;

    font-family:
        'Dancing Script',
        cursive;

    font-size:
        clamp(42px,10vw,65px);
}

.welcome-box p {

    margin-top: 10px;

    color: #87425f;

    font-size: 18px;
}

.enter-btn {

    margin-top: 25px;

    padding: 15px 32px;

    border: none;

    border-radius: 50px;

    background:
        linear-gradient(
            135deg,
            #ff6f9f,
            #d83e77
        );

    color: white;

    font-family: inherit;

    font-size: 18px;

    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 12px 30px
        rgba(214,59,113,.3);

    transition:
        transform .3s ease,
        box-shadow .3s ease;
}

.enter-btn:hover {
    transform: scale(1.08);

    box-shadow:
        0 18px 35px
        rgba(214,59,113,.4);
}


/* ==============================
   MAIN
============================== */

.container {

    min-height: 100vh;

    display: flex;

    justify-content: center;

    padding:
        30px 15px 80px;

    position: relative;
}

.card {

    width:
        min(100%, 700px);

    padding:
        clamp(25px,5vw,50px)
        clamp(17px,5vw,45px);

    border-radius: 38px;

    background:
        rgba(255,255,255,.86);

    backdrop-filter:
        blur(18px);

    box-shadow:
        0 30px 90px
        rgba(165,55,100,.2);

    text-align: center;

    animation:
        cardAppear
        1.2s ease;
}

@keyframes cardAppear {

    from {
        opacity: 0;
        transform:
            translateY(40px)
            scale(.92);
    }

    to {
        opacity: 1;
        transform:
            translateY(0)
            scale(1);
    }
}


/* ==============================
   HEADINGS
============================== */

.small {

    color: #a45172;

    font-size:
        clamp(11px,2vw,16px);

    font-weight: 700;

    letter-spacing: 2px;
}

h1 {

    margin-top: 10px;

    color: #d94b80;

    font-size:
        clamp(42px,11vw,80px);

    line-height: .95;

    animation:
        heartbeat
        2s
        infinite;
}

@keyframes heartbeat {

    0%,100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.05);
    }
}

.age {

    display: inline-block;

    margin-top: 18px;

    padding:
        7px 20px;

    border-radius: 50px;

    background: #fff0f6;

    color: #b63264;

    font-size: 19px;

    font-weight: 700;
}

.subtitle {

    margin-top: 18px;

    color: #94345c;

    font-family:
        'Dancing Script',
        cursive;

    font-size:
        clamp(29px,7vw,42px);
}

.divider {

    width: 90px;

    height: 4px;

    margin: 25px auto;

    border-radius: 50px;

    background: #e98caf;
}


/* ==============================
   GIFT
============================== */

.gift-area {

    margin-top: 10px;
}

.gift {

    width: 145px;
    height: 125px;

    margin: auto;

    position: relative;

    transition:
        transform .4s ease;
}

.gift:hover {

    transform:
        translateY(-8px)
        rotate(-3deg);
}

.gift button {

    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    border: none;

    background: transparent;

    cursor: pointer;
}

.gift-box {

    position: absolute;

    left: 13px;
    bottom: 0;

    width: 120px;
    height: 78px;

    background: #f875a5;

    border-radius: 9px;

    box-shadow:
        0 12px 25px
        rgba(214,74,123,.25);
}

.gift-box::after {

    content: "";

    position: absolute;

    left: 50px;

    width: 20px;

    height: 100%;

    background: #ffd5e3;
}

.gift-lid {

    position: absolute;

    left: 7px;
    top: 27px;

    width: 132px;
    height: 30px;

    background: #e65389;

    border-radius: 8px;

    z-index: 3;

    transform-origin: left bottom;

    transition:
        transform .8s
        cubic-bezier(.22,1,.36,1);
}

.gift-ribbon {

    position: absolute;

    left: 52px;
    top: 0;

    width: 35px;
    height: 53px;

    border:
        7px solid #ffd5e3;

    border-bottom: 0;

    border-radius:
        50% 50% 0 0;

    z-index: 4;

    transition:
        transform .8s
        cubic-bezier(.22,1,.36,1);
}

.gift.open .gift-lid {

    transform:
        translate(-5px,-65px)
        rotate(-10deg);
}

.gift.open .gift-ribbon {

    transform:
        translate(-5px,-65px)
        rotate(-10deg);
}

.tap-text {

    margin-top: 5px;

    color: #9b5070;

    animation:
        pulse 1.5s infinite;
}

@keyframes pulse {

    50% {
        opacity: .45;
    }
}


/* ==============================
   MESSAGE
============================== */

.message {

    max-height: 0;

    overflow: hidden;

    opacity: 0;

    transform:
        translateY(25px);

    transition:
        max-height 1.2s ease,
        opacity .8s ease,
        transform .8s ease;
}

.message.show {

    max-height: 1200px;

    opacity: 1;

    transform:
        translateY(0);

    margin-top: 25px;
}

.message p {

    max-width: 570px;

    margin:
        14px auto;

    font-size:
        clamp(15px,2.6vw,18px);

    line-height: 1.65;
}

.sweet {

    color: #bd3569;

    font-family:
        'Dancing Script',
        cursive;

    font-size:
        clamp(25px,5vw,32px) !important;
}

.typewriter {

    min-height: 30px;

    white-space: pre-wrap;
}

.signature {

    margin-top: 25px;

    color: #c83f72;

    font-family:
        'Dancing Script',
        cursive;

    font-size: 38px;

    line-height: 1;
}


/* ==============================
   INTERACTIVE SECTION
============================== */

.interactive {

    display: none;

    margin-top: 40px;

    animation:
        sectionAppear
        1s ease;
}

.interactive.show {
    display: block;
}

@keyframes sectionAppear {

    from {
        opacity: 0;
        transform:
            translateY(25px);
    }

    to {
        opacity: 1;
        transform:
            translateY(0);
    }
}

.section-title {

    color: #c33e70;

    font-family:
        'Dancing Script',
        cursive;

    font-size:
        clamp(28px,6vw,38px);

    margin-bottom: 15px;
}


/* ==============================
   HEART BUTTON
============================== */

.heart-game {

    margin: 25px auto;

    width: min(100%,500px);

    padding: 20px;

    border-radius: 25px;

    background: #fff3f8;

    box-shadow:
        inset 0 0 0 2px #ffe0eb;
}

.heart-game button {

    border: none;

    background: transparent;

    font-size: 65px;

    cursor: pointer;

    transition:
        transform .2s ease;
}

.heart-game button:active {

    transform:
        scale(.75);
}

#heartCount {

    margin-top: 5px;

    color: #c83f72;

    font-weight: 700;

    font-size: 18px;
}


/* ==============================
   LOVE METER
============================== */

.meter {

    width: 100%;

    height: 25px;

    margin: 15px 0;

    border-radius: 50px;

    background: #ffe0eb;

    overflow: hidden;
}

.meter-fill {

    width: 0%;

    height: 100%;

    border-radius: 50px;

    background:
        linear-gradient(
            90deg,
            #ff9dbc,
            #d83e77
        );

    transition:
        width .5s ease;
}

.meter-text {

    font-size: 17px;

    color: #9a4668;
}

.meter-btn {

    margin-top: 12px;

    padding:
        11px 22px;

    border: none;

    border-radius: 50px;

    background: #e9578d;

    color: white;

    font-family: inherit;

    font-weight: 700;

    cursor: pointer;
}


/* ==============================
   28 REASONS
============================== */

.reason-box {

    min-height: 120px;

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 20px;

    margin-top: 15px;

    border-radius: 25px;

    background:
        linear-gradient(
            135deg,
            #fff4f8,
            #ffe1ec
        );

    font-family:
        'Dancing Script',
        cursive;

    font-size:
        clamp(24px,5vw,32px);

    color: #a93261;

    transition:
        transform .3s ease;
}

.reason-btn {

    margin-top: 15px;

    padding:
        12px 25px;

    border: none;

    border-radius: 50px;

    background:
        linear-gradient(
            135deg,
            #ff72a0,
            #d9437d
        );

    color: white;

    font-family: inherit;

    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 8px 20px
        rgba(215,61,117,.2);
}


/* ==============================
   BALLOONS
============================== */

.balloon-area {

    min-height: 240px;

    position: relative;

    margin-top: 15px;

    overflow: hidden;

    border-radius: 25px;

    background:
        linear-gradient(
            #fff6fa,
            #ffe5ef
        );
}

.balloon {

    position: absolute;

    bottom: -100px;

    width: 55px;
    height: 70px;

    border-radius:
        50% 50% 45% 45%;

    cursor: pointer;

    animation:
        balloonFloat
        linear forwards;
}

.balloon::after {

    content: "";

    position: absolute;

    width: 1px;

    height: 70px;

    background: #b66;

    left: 50%;

    top: 68px;
}

@keyframes balloonFloat {

    to {

        bottom: 110%;

        transform:
            translateX(
                var(--drift)
            )
            rotate(15deg);
    }
}

.pop {

    animation:
        balloonPop
        .25s
        forwards !important;
}

@keyframes balloonPop {

    50% {
        transform: scale(1.5);
    }

    100% {
        opacity: 0;
        transform: scale(0);
    }
}


/* ==============================
   FINAL SURPRISE
============================== */

.surprise-btn {

    margin-top: 30px;

    padding:
        16px 28px;

    border: none;

    border-radius: 50px;

    background:
        linear-gradient(
            135deg,
            #ff5f96,
            #b92862
        );

    color: white;

    font-family: inherit;

    font-size: 18px;

    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 12px 30px
        rgba(185,40,98,.3);

    animation:
        buttonGlow
        2s
        infinite;
}

@keyframes buttonGlow {

    50% {
        box-shadow:
            0 12px 40px
            rgba(185,40,98,.55);
    }
}


/* ==============================
   FINAL OVERLAY
============================== */

#finalSurprise {

    position: fixed;

    inset: 0;

    z-index: 900;

    display: flex;

    align-items: center;

    justify-content: center;

    text-align: center;

    padding: 20px;

    background:
        radial-gradient(
            circle,
            rgba(255,255,255,.96),
            rgba(255,153,190,.97)
        );

    opacity: 0;

    visibility: hidden;

    transition:
        opacity 1s ease;
}

#finalSurprise.show {

    opacity: 1;

    visibility: visible;
}

.final-box {

    max-width: 650px;

    animation:
        finalAppear
        1.2s
        ease;
}

@keyframes finalAppear {

    from {
        transform:
            scale(.5)
            rotate(-5deg);

        opacity: 0;
    }

    to {
        transform:
            scale(1)
            rotate(0);

        opacity: 1;
    }
}

.final-box .big-heart {

    font-size:
        clamp(70px,20vw,150px);

    animation:
        heartbeat
        1.5s
        infinite;
}

.final-box h2 {

    color: #c72e68;

    font-family:
        'Dancing Script',
        cursive;

    font-size:
        clamp(48px,12vw,85px);

    line-height: .9;
}

.final-box p {

    margin-top: 20px;

    color: #74334f;

    font-size:
        clamp(18px,4vw,25px);

    line-height: 1.5;
}

.close-final {

    margin-top: 25px;

    padding:
        12px 25px;

    border: none;

    border-radius: 50px;

    background: #c83f72;

    color: white;

    font-family: inherit;

    font-weight: 700;

    cursor: pointer;
}


/* ==============================
   FLOATING EFFECTS
============================== */

.floating {

    position: fixed;

    bottom: -40px;

    pointer-events: none;

    z-index: 50;

    animation:
        floatUp
        linear
        forwards;
}

@keyframes floatUp {

    from {
        opacity: 0;

        transform:
            translateY(0)
            rotate(0);
    }

    15% {
        opacity: 1;
    }

    to {
        opacity: 0;

        transform:
            translateY(-110vh)
            rotate(360deg);
    }
}

.sparkle {

    position: fixed;

    pointer-events: none;

    z-index: 200;

    animation:
        sparkle .9s
        ease-out
        forwards;
}

@keyframes sparkle {

    from {
        opacity: 1;

        transform:
            scale(.2)
            rotate(0);
    }

    to {
        opacity: 0;

        transform:
            scale(2)
            rotate(180deg);
    }
}


/* ==============================
   MOBILE
============================== */

@media(max-width:500px) {

    .container {
        padding:
            15px 10px 60px;
    }

    .card {
        border-radius: 28px;
    }

    .message p {
        font-size: 15px;
    }

    .signature {
        font-size: 32px;
    }

    .heart-game button {
        font-size: 55px;
    }
}

</style>
</head>


<body>


<!-- ==================================
     WELCOME SCREEN
================================== -->

<div id="welcome">

    <div class="welcome-box">

        <div class="welcome-emoji">
            🎀
        </div>

        <h2>
            For Someone<br>
            Very Special...
        </h2>

        <p>
            I made a little surprise<br>
            especially for you. 💕
        </p>

        <button
            class="enter-btn"
            id="enterBtn"
        >
            💗 Tap to Enter 💗
        </button>

    </div>

</div>


<!-- ==================================
     MAIN
================================== -->

<div class="container">

<div class="card">


    <div class="small">
        A VERY SPECIAL DAY FOR A VERY SPECIAL GIRL 💕
    </div>


    <h1>
        Happy Birthday!
    </h1>


    <div class="age">
        ✨ 28th Birthday ✨
    </div>


    <div class="subtitle">
        HAPPY BIRTHDAY, MAHAL 💗
    </div>


    <div class="divider"></div>


    <!-- GIFT -->

    <div class="gift-area">

        <div class="gift" id="gift">

            <button
                type="button"
                aria-label="Open birthday gift"
            >

                <span
                    class="gift-lid">
                </span>

                <span
                    class="gift-box">
                </span>

                <span
                    class="gift-ribbon">
                </span>

            </button>

        </div>


        <div class="tap-text">
            🎁 Tap the gift to open your surprise 🎁
        </div>

    </div>


    <!-- MESSAGE -->

    <div
        class="message"
        id="message"
    >

        <p class="sweet">
            To the most adorable girl in my world... 💕
        </p>


        <p>
            Happy 28th Birthday, Mahal! 🥹💗
        </p>


        <p class="typewriter" id="typewriter"></p>


        <p>
            I hope this new chapter of your life brings you
            countless reasons to smile, beautiful memories
            to keep, and dreams that slowly turn into reality.
        </p>


        <p>
            Thank you for being you — for your sweetness,
            your beautiful smile, your little quirks,
            and for making ordinary moments feel
            a little more special. ❤️
        </p>


        <p>
            You deserve all the love, happiness, peace,
            and beautiful things this world can give.
        </p>


        <p>
            No matter how many birthdays come and go,
            I hope you always remember that there will
            always be someone here cheering for you,
            caring for you, and wishing nothing but
            the best for you.
        </p>


        <p class="sweet">
            Keep smiling, keep shining,
            and please never forget just how adorable
            you are. 🥰
        </p>


        <div class="signature">
            With all my love,<br>
            DAN ❤️
        </div>


        <!-- INTERACTIVE CONTENT -->

        <div
            class="interactive"
            id="interactive"
        >


            <!-- HEART GAME -->

            <div class="section-title">
                💕 Catch My Hearts 💕
            </div>

            <div class="heart-game">

                <p>
                    Tap the heart and collect
                    all the love I have for you. 🥰
                </p>

                <button
                    id="heartButton"
                    type="button"
                >
                    ❤️
                </button>

                <div id="heartCount">
                    Love collected: 0 💕
                </div>

            </div>


            <!-- LOVE METER -->

            <div class="section-title">
                💗 How Much Do I Love You?
            </div>

            <div class="meter">

                <div
                    class="meter-fill"
                    id="meterFill"
                ></div>

            </div>

            <div
                class="meter-text"
                id="meterText"
            >
                0% — Tap the button! 🥺
            </div>

            <button
                class="meter-btn"
                id="meterBtn"
                type="button"
            >
                💖 Add More Love
            </button>


            <!-- 28 REASONS -->

            <div
                class="section-title"
                style="margin-top:40px;"
            >
                🌸 28 Reasons You're Adorable 🌸
            </div>

            <div
                class="reason-box"
                id="reasonBox"
            >
                Tap below to discover one... 💕
            </div>

            <button
                class="reason-btn"
                id="reasonBtn"
                type="button"
            >
                💕 Reveal a Reason
            </button>


            <!-- BALLOONS -->

            <div
                class="section-title"
                style="margin-top:40px;"
            >
                🎈 Pop The Birthday Balloons 🎈
            </div>

            <p>
                Tap the balloons before they fly away! 💕
            </p>

            <div
                class="balloon-area"
                id="balloonArea"
            ></div>


            <!-- FINAL -->

            <button
                class="surprise-btn"
                id="surpriseBtn"
                type="button"
            >
                🎁 ONE LAST SURPRISE 🎁
            </button>


        </div>

    </div>


    <div class="footer">
        Made with lots of love, just for you. 🌸
    </div>


</div>

</div>


<!-- ==================================
     FINAL SURPRISE
================================== -->

<div id="finalSurprise">

    <div class="final-box">

        <div class="big-heart">
            💖
        </div>

        <h2>
            Happy 28th,<br>
            Mahal!
        </h2>

        <p>
            You are one of the sweetest,
            cutest and most precious people
            in my life. 🥹💕
        </p>

        <p>
            I hope your 28th year becomes
            one of your happiest chapters yet.
        </p>

        <p>
            I love seeing you smile. ❤️
        </p>

        <div
            style="
                margin-top:25px;
                font-family:'Dancing Script';
                font-size:35px;
                color:#c83f72;
            "
        >
            Always yours,<br>
            DAN ❤️
        </div>

        <button
            class="close-final"
            id="closeFinal"
        >
            💕 Keep My Love
        </button>

    </div>

</div>


<script>

/* ==================================
   VARIABLES
================================== */

const welcome =
    document.getElementById("welcome");

const enterBtn =
    document.getElementById("enterBtn");

const gift =
    document.getElementById("gift");

const message =
    document.getElementById("message");

const interactive =
    document.getElementById("interactive");

const typewriter =
    document.getElementById("typewriter");

const heartButton =
    document.getElementById("heartButton");

const heartCount =
    document.getElementById("heartCount");

const meterFill =
    document.getElementById("meterFill");

const meterText =
    document.getElementById("meterText");

const meterBtn =
    document.getElementById("meterBtn");

const reasonBox =
    document.getElementById("reasonBox");

const reasonBtn =
    document.getElementById("reasonBtn");

const balloonArea =
    document.getElementById("balloonArea");

const surpriseBtn =
    document.getElementById("surpriseBtn");

const finalSurprise =
    document.getElementById("finalSurprise");

const closeFinal =
    document.getElementById("closeFinal");


let opened = false;

let hearts = 0;

let love = 0;

let reasonIndex = 0;


/* ==================================
   WELCOME
================================== */

enterBtn.addEventListener(
    "click",
    () => {

        welcome.classList.add("hide");

        createHeartExplosion(20);

    }
);


/* ==================================
   OPEN GIFT
================================== */

gift.addEventListener(
    "click",
    openGift
);


function openGift() {

    if (opened) return;

    opened = true;

    gift.classList.add("open");

    setTimeout(
        () => {

            message.classList.add("show");

        },
        450
    );


    setTimeout(
        () => {

            interactive.classList.add("show");

            typeWriter();

            createHeartExplosion(35);

            createSparkles(25);

            startBalloons();

        },
        1300
    );

}


/* ==================================
   TYPEWRITER
================================== */

const text =
`I just want you to know that you mean more to me than words can easily explain. Every little smile, every laugh, and every moment with you is something I treasure. ❤️`;

let typeIndex = 0;

function typeWriter() {

    if (
        typeIndex <
        text.length
    ) {

        typewriter.textContent +=
            text.charAt(typeIndex);

        typeIndex++;

        setTimeout(
            typeWriter,
            35
        );

    }

}


/* ==================================
   HEART GAME
================================== */

heartButton.addEventListener(
    "click",
    () => {

        hearts++;

        heartCount.textContent =
            "Love collected: "
            + hearts
            + " 💕";


        heartButton.animate(
            [
                {
                    transform:
                        "scale(1)"
                },

                {
                    transform:
                        "scale(1.5)"
                },

                {
                    transform:
                        "scale(1)"
                }
            ],
            {
                duration: 350
            }
        );


        createHeartExplosion(5);


        if (hearts === 10) {

            heartCount.textContent =
                "10 hearts! But honestly... I have infinite love for you. 🥹❤️";

        }

    }
);


/* ==================================
   LOVE METER
================================== */

meterBtn.addEventListener(
    "click",
    () => {

        love += 10;


        if (love >= 100) {

            love = 100;

            meterText.textContent =
                "100%... ERROR! My love cannot fit in this meter! 🥹❤️";

            createHeartExplosion(40);

        } else {

            meterText.textContent =
                love +
                "% — And still growing... 💕";

        }


        meterFill.style.width =
            love + "%";

    }
);


